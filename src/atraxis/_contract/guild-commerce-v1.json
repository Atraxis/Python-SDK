    "/transfers": {
      "post": {
        "description": "Выполняет 1–10 переводов одной операцией. Если один перевод невозможен, не выполняется ни один. Предметы передаются guild → player. Валюта поддерживает supply ↔ guild, guild ↔ player и, при transferable: true, player → player.",
        "operationId": "createGuildTransfers",
        "parameters": [
          {
            "description": "Постоянный уникальный ключ одного перевода или заказа.",
            "example": "order-2026-09-11-0001",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "transfers": [
                  {
                    "amount": "25",
                    "asset": {
                      "code": "TOKEN",
                      "type": "guild_currency"
                    },
                    "from": {
                      "type": "guild"
                    },
                    "to": {
                      "player_id": "100001",
                      "type": "player"
                    }
                  }
                ]
              },
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "transfers": {
                    "items": {
                      "$ref": "#/components/schemas/Transfer"
                    },
                    "maxItems": 10,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "transfers"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "operation_id": "00000000-0000-4000-8000-000000000002",
                  "transfers": [
                    {
                      "amount": "25",
                      "asset": {
                        "code": "TOKEN",
                        "type": "guild_currency"
                      },
                      "from": {
                        "type": "guild"
                      },
                      "index": 0,
                      "to": {
                        "player_id": "100001",
                        "type": "player"
                      }
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/TransferResult"
                }
              }
            },
            "description": "Все части применены либо возвращён результат безопасного повтора.",
            "headers": {
              "Idempotency-Replayed": {
                "description": "Присутствует только для сохранённого повтора.",
                "schema": {
                  "enum": [
                    "true"
                  ],
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestID"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidJSON"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "423": {
            "$ref": "#/components/responses/TradeBlocked"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Передать ценности",
        "tags": [
          "Переводы"
        ],
        "x-codeSamples": [
          {
            "label": "cURL",
            "lang": "cURL",
            "source": "curl --request POST \\\n  --url 'https://atraxisonline.com/api/external/v1/transfers' \\\n  --header 'Authorization: Bearer agk_example.redacted' \\\n  --header 'Content-Type: application/json' \\\n  --header 'Idempotency-Key: order-2026-09-11-0001' \\\n  --data '{\"transfers\":[{\"asset\":{\"type\":\"guild_currency\",\"code\":\"TOKEN\"},\"from\":{\"type\":\"guild\"},\"to\":{\"type\":\"player\",\"player_id\":\"100001\"},\"amount\":\"25\"}]}'"
          },
          {
            "label": "Python · sync",
            "lang": "Python",
            "source": "from atraxis import AtraxisClient, CurrencyTransfer\n\nwith AtraxisClient(\"agk_example.redacted\") as client:\n    result = client.transfer(\n        [CurrencyTransfer.to_player(\"TOKEN\", player_id=100001, amount=25)],\n        idempotency_key=\"order-2026-09-11-0001\",\n    )"
          },
          {
            "label": "Python · async",
            "lang": "Python",
            "source": "import asyncio\nfrom atraxis import AsyncAtraxisClient, CurrencyTransfer\n\nasync def main() -> None:\n    async with AsyncAtraxisClient(\"agk_example.redacted\") as client:\n        await client.transfer(\n            [CurrencyTransfer.to_player(\"TOKEN\", player_id=100001, amount=25)],\n            idempotency_key=\"order-2026-09-11-0001\",\n        )\n\nasyncio.run(main())"
          }
        ]
      }
    },
