{
  "components": {
    "headers": {
      "RequestID": {
        "description": "Идентификатор запроса. Передайте его поддержке, если потребуется помощь.",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      }
    },
    "parameters": {
      "Cursor": {
        "description": "Значение next_cursor из предыдущего ответа для загрузки следующей страницы.",
        "in": "query",
        "name": "cursor",
        "schema": {
          "maxLength": 512,
          "type": "string"
        }
      },
      "PageSize": {
        "description": "Сколько элементов вернуть на одной странице.",
        "in": "query",
        "name": "page_size",
        "schema": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "responses": {
      "BodyTooLarge": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "JSON-тело превышает 32 КиБ.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "IdempotencyConflict": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Ключ уже использован с другим телом или операция ещё выполняется.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "InvalidJSON": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Некорректный JSON или неизвестное поле.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "InvalidPagination": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "page_size или cursor заданы неверно.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "InvalidPlayerID": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "player_id должен быть положительным числом.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "NotFound": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Игрок, валюта или позиция склада не найдены.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "Problem": {
        "content": {
          "application/problem+json": {
            "example": {
              "detail": "Проверьте направление, актив, сумму, остаток и вместимость.",
              "request_id": "00000000-0000-4000-8000-000000000001",
              "status": 422,
              "title": "Операция отклонена",
              "type": "urn:atraxis:problem:unprocessable-transfer"
            },
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Ошибка запроса.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "RateLimited": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Лимит запросов исчерпан.",
        "headers": {
          "Retry-After": {
            "description": "Пауза перед повтором, в секундах.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "TradeBlocked": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Выдача и переводы временно приостановлены.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Токен не передан, недействителен или отозван.",
        "headers": {
          "WWW-Authenticate": {
            "description": "Ожидаемая схема авторизации.",
            "schema": {
              "example": "Bearer realm=\"guild-api\"",
              "type": "string"
            }
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "Unprocessable": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Параметры операции недопустимы.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "UnsupportedMediaType": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Требуется Content-Type application/json.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      }
    },
    "schemas": {
      "Activity": {
        "additionalProperties": false,
        "properties": {
          "asset": {
            "$ref": "#/components/schemas/ActivityAsset"
          },
          "balance_after": {
            "$ref": "#/components/schemas/NonNegativeAmount",
            "description": "Баланс отправителя после операции; для выпуска и погашения — общий выпуск."
          },
          "balance_before": {
            "$ref": "#/components/schemas/NonNegativeAmount",
            "description": "Баланс отправителя до операции; для выпуска и погашения — общий выпуск."
          },
          "event_id": {
            "description": "Постоянный идентификатор этой записи для сверки.",
            "format": "uuid",
            "type": "string"
          },
          "fee": {
            "$ref": "#/components/schemas/NonNegativeAmount",
            "description": "Удержанная комиссия."
          },
          "from": {
            "$ref": "#/components/schemas/ActivityParty"
          },
          "gross": {
            "$ref": "#/components/schemas/Amount",
            "description": "Количество до удержания комиссии."
          },
          "kind": {
            "description": "Тип движения склада или внутренней валюты.",
            "enum": [
              "warehouse_deposit",
              "warehouse_withdrawal",
              "currency_issue",
              "currency_retire",
              "currency_transfer"
            ],
            "type": "string"
          },
          "leg_index": {
            "description": "Номер части внутри операции, начиная с 0.",
            "minimum": 0,
            "type": "integer"
          },
          "net": {
            "$ref": "#/components/schemas/Amount",
            "description": "Количество после удержания комиссии."
          },
          "occurred_at": {
            "format": "date-time",
            "type": "string"
          },
          "operation_id": {
            "description": "Общий идентификатор всех частей одной операции.",
            "format": "uuid",
            "type": "string"
          },
          "source": {
            "description": "Где началась операция: чат, игра, API или системное действие.",
            "enum": [
              "chat",
              "game",
              "api",
              "system"
            ],
            "type": "string"
          },
          "to": {
            "$ref": "#/components/schemas/ActivityParty"
          }
        },
        "required": [
          "event_id",
          "occurred_at",
          "operation_id",
          "kind",
          "source",
          "from",
          "to",
          "asset",
          "gross",
          "fee",
          "net",
          "leg_index"
        ],
        "type": "object"
      },
      "ActivityAsset": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "$ref": "#/components/schemas/DecimalID"
              },
              "type": {
                "const": "game_item"
              },
              "warehouse_item_id": {
                "$ref": "#/components/schemas/DecimalID"
              }
            },
            "required": [
              "type",
              "item_id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "credits"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "echos"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "currency_code": {
                "$ref": "#/components/schemas/CurrencyCode"
              },
              "type": {
                "const": "guild_currency"
              }
            },
            "required": [
              "type",
              "currency_code"
            ],
            "type": "object"
          }
        ]
      },
      "ActivityPage": {
        "additionalProperties": false,
        "properties": {
          "available_since": {
            "description": "Начало доступной истории операций.",
            "format": "date-time",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Activity"
            },
            "maxItems": 100,
            "type": "array"
          },
          "next_cursor": {
            "description": "Курсор следующей страницы. Поле отсутствует на последней странице.",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ActivityParty": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "guild"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "supply"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "player_id": {
                "$ref": "#/components/schemas/DecimalID"
              },
              "type": {
                "const": "player"
              }
            },
            "required": [
              "type",
              "player_id"
            ],
            "type": "object"
          }
        ]
      },
      "Amount": {
        "description": "Целое значение от 1 до 9 000 000 000 000 000.",
        "example": "25",
        "pattern": "^([1-9][0-9]{0,14}|[1-8][0-9]{15}|9000000000000000)$",
        "type": "string"
      },
      "Currency": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "name": {
            "description": "Название валюты для игроков.",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "total_supply": {
            "$ref": "#/components/schemas/NonNegativeAmount",
            "description": "Сколько единиц валюты сейчас выпущено."
          },
          "transferable": {
            "description": "Разрешены ли переводы этой валюты между игроками.",
            "type": "boolean"
          },
          "treasury_balance": {
            "$ref": "#/components/schemas/NonNegativeAmount",
            "description": "Сколько выпущенных единиц остаётся на балансе гильдии."
          }
        },
        "required": [
          "code",
          "name",
          "transferable",
          "total_supply",
          "treasury_balance"
        ],
        "type": "object"
      },
      "CurrencyCode": {
        "description": "Постоянный код валюты из 1–16 символов.",
        "example": "TOKEN",
        "pattern": "^[A-Z][A-Z0-9_]{0,15}$",
        "type": "string"
      },
      "CurrencyUpdate": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "transferable": {
            "description": "Разрешить или запретить переводы между игроками.",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "transferable"
        ],
        "type": "object"
      },
      "DecimalID": {
        "description": "Положительный десятичный идентификатор, переданный строкой.",
        "maxLength": 19,
        "pattern": "^[1-9][0-9]*$",
        "type": "string"
      },
      "GameItemAsset": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "game_item"
          },
          "warehouse_item_id": {
            "$ref": "#/components/schemas/DecimalID"
          }
        },
        "required": [
          "type",
          "warehouse_item_id"
        ],
        "type": "object"
      },
      "GuildCurrencyAsset": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "type": {
            "const": "guild_currency"
          }
        },
        "required": [
          "type",
          "code"
        ],
        "type": "object"
      },
      "NonNegativeAmount": {
        "description": "Неотрицательное целое значение не больше 9 000 000 000 000 000.",
        "example": "0",
        "pattern": "^(0|[1-9][0-9]{0,14}|[1-8][0-9]{15}|9000000000000000)$",
        "type": "string"
      },
      "Party": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "guild"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "supply"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "player_id": {
                "$ref": "#/components/schemas/DecimalID"
              },
              "type": {
                "const": "player"
              }
            },
            "required": [
              "type",
              "player_id"
            ],
            "type": "object"
          }
        ]
      },
      "PlayerBalances": {
        "additionalProperties": false,
        "properties": {
          "balances": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "balance": {
                  "$ref": "#/components/schemas/NonNegativeAmount"
                },
                "code": {
                  "$ref": "#/components/schemas/CurrencyCode"
                }
              },
              "required": [
                "code",
                "balance"
              ],
              "type": "object"
            },
            "maxItems": 100,
            "type": "array"
          },
          "player_id": {
            "$ref": "#/components/schemas/DecimalID"
          }
        },
        "required": [
          "player_id",
          "balances"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "request_id"
        ],
        "type": "object"
      },
      "Transfer": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "asset": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GameItemAsset"
              },
              {
                "$ref": "#/components/schemas/GuildCurrencyAsset"
              }
            ]
          },
          "from": {
            "$ref": "#/components/schemas/Party"
          },
          "to": {
            "$ref": "#/components/schemas/Party"
          }
        },
        "required": [
          "asset",
          "from",
          "to",
          "amount"
        ],
        "type": "object"
      },
      "TransferResult": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "description": "Общий идентификатор всех частей выполненной операции.",
            "format": "uuid",
            "type": "string"
          },
          "transfers": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "$ref": "#/components/schemas/Amount"
                },
                "asset": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/GameItemAsset"
                    },
                    {
                      "$ref": "#/components/schemas/GuildCurrencyAsset"
                    }
                  ]
                },
                "from": {
                  "$ref": "#/components/schemas/Party"
                },
                "index": {
                  "maximum": 9,
                  "minimum": 0,
                  "type": "integer"
                },
                "to": {
                  "$ref": "#/components/schemas/Party"
                }
              },
              "required": [
                "index",
                "asset",
                "from",
                "to",
                "amount"
              ],
              "type": "object"
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "operation_id",
          "transfers"
        ],
        "type": "object"
      },
      "Warehouse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/WarehouseItem"
            },
            "maxItems": 100,
            "type": "array"
          },
          "next_cursor": {
            "description": "Курсор следующей страницы. Поле отсутствует на последней странице.",
            "type": "string"
          },
          "slots_total": {
            "description": "Общая вместимость склада в ячейках.",
            "minimum": 0,
            "type": "integer"
          },
          "slots_used": {
            "description": "Сколько ячеек сейчас занято.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "slots_used",
          "slots_total",
          "items"
        ],
        "type": "object"
      },
      "WarehouseItem": {
        "additionalProperties": false,
        "properties": {
          "durability": {
            "description": "Текущая прочность; 0 для предметов без прочности.",
            "type": "integer"
          },
          "item_id": {
            "$ref": "#/components/schemas/DecimalID",
            "description": "Игровой идентификатор типа предмета."
          },
          "max_durability": {
            "description": "Максимальная прочность; 0 для предметов без прочности.",
            "type": "integer"
          },
          "name": {
            "description": "Название предмета, которое видит игрок.",
            "type": "string"
          },
          "quantity": {
            "description": "Доступное количество.",
            "minimum": 1,
            "type": "integer"
          },
          "transfer_restricted": {
            "description": "true, если эту позицию нельзя выдать через API.",
            "type": "boolean"
          },
          "warehouse_item_id": {
            "$ref": "#/components/schemas/DecimalID",
            "description": "Идентификатор этой позиции склада. Используется в переводе предмета."
          }
        },
        "required": [
          "warehouse_item_id",
          "item_id",
          "name",
          "quantity",
          "durability",
          "max_durability",
          "transfer_restricted"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "guildBearer": {
        "bearerFormat": "agk_…",
        "description": "Приватный бессрочный токен, который выпускает лидер в разделе «Интеграции гильдии».",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Управление складом и внутренними валютами гильдии из бота, сайта или учётной системы.",
    "title": "API гильдии Atraxis",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/activity": {
      "get": {
        "description": "Возвращает движения ценностей гильдии от новых к старым. next_cursor загружает следующую страницу.",
        "operationId": "listGuildActivity",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "available_since": "2026-09-01T00:00:00Z",
                  "items": [
                    {
                      "asset": {
                        "currency_code": "TOKEN",
                        "type": "guild_currency"
                      },
                      "balance_after": "8475",
                      "balance_before": "8500",
                      "event_id": "00000000-0000-4000-8000-000000000003",
                      "fee": "0",
                      "from": {
                        "type": "guild"
                      },
                      "gross": "25",
                      "kind": "currency_transfer",
                      "leg_index": 0,
                      "net": "25",
                      "occurred_at": "2026-09-12T12:30:00Z",
                      "operation_id": "00000000-0000-4000-8000-000000000002",
                      "source": "api",
                      "to": {
                        "player_id": "100001",
                        "type": "player"
                      }
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/ActivityPage"
                }
              }
            },
            "description": "Страница истории операций.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestID"
              }
            }
          },
          "401": {
